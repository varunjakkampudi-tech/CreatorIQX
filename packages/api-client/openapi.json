          "idea",
          "planned",
          "drafting",
          "qa",
          "in_review",
          "approved",
          "scheduled",
          "published",
          "analyzed",
          "rejected",
          "archived"
        ],
        "title": "VideoStatus",
        "type": "string"
      }
