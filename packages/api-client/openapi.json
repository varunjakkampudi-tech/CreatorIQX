                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The video board",
        "tags": [
          "videos"
        ]
      }
    },
    "/api/v1/videos/{video_id}/transition": {
      "post": {
        "operationId": "transition_video_api_v1_videos__video_id__transition_post",
        "parameters": [
          {
            "in": "path",
            "name": "video_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Video Id",
              "type": "string"
            }
