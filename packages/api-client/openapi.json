{
  "components": {
    "schemas": {
      "CurrentWorkspaceOut": {
        "description": "The session's workspace and what the caller may do in it.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "CurrentWorkspaceOut",
        "type": "object"
      },
      "MeOut": {
        "description": "The caller's own identity and current workspace role.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "workspace_id",
          "role"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "Role": {
        "description": "A member's role within one workspace.",
        "enum": [
          "owner",
          "editor",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionOut": {
        "description": "The signed-in user and the token the client must send on unsafe requests.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "workspace_id",
          "subject",
          "email",
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CreatorIQX API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "End the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "read_session_api_v1_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "read_me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The signed-in user",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/workspaces/current": {
      "get": {
        "operationId": "read_current_workspace_api_v1_workspaces_current_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentWorkspaceOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The current workspace",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness: dependencies answer",
        "tags": [
          "health"
        ]
      }
    }
  }
}
