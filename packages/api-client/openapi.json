        "title": "PlanOut",
        "type": "object"
      },
      "Role": {
        "description": "A member's role within one workspace.",
        "enum": [
          "owner",
          "editor",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionOut": {
        "description": "The signed-in user and the token the client must send on unsafe requests.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
