# CreatorIQX environment template.
# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Every variable is read by the app at startup; missing required values fail fast.

# --- Runtime -----------------------------------------------------------------
# local | test | staging | production
APP_ENV=local
# Base URL the browser uses (web app and API share one origin in dev)
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- Database (PostgreSQL) -----------------------------------------------------
# Owner role: migrations only (owns tables)
DATABASE_OWNER_URL=postgresql+asyncpg://creatoriqx_owner:change-me-owner@127.0.0.1:55432/creatoriqx
# Runtime role: API, worker, MCP server (NOBYPASSRLS, owns no tables)
DATABASE_APP_URL=postgresql+asyncpg://creatoriqx_app:change-me-app@127.0.0.1:55432/creatoriqx
# Local Docker Postgres (infra/compose). Host port 55432 avoids clashing with a
# Postgres already installed on the machine. Superuser is used only at first start.
POSTGRES_HOST_PORT=55432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Passwords for the two CreatorIQX roles, created by infra/compose/postgres-init
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app

# --- Redis -------------------------------------------------------------------
# Host port 56379 avoids clashing with a Redis already on the machine
REDIS_HOST_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# --- Task queue (ADR 0003) ----------------------------------------------------
# Separate logical Redis database from REDIS_URL above, so Celery's own keys
# (broker queue, result backend) never share a keyspace with sessions/quota.
CELERY_BROKER_URL=redis://127.0.0.1:56379/1

# --- Sessions ----------------------------------------------------------------
# Random secret, at least 64 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Google login (OIDC, login-only client, ADR 0004) ----------------------------
# Scopes are fixed in code to: openid email profile
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# --- Auth rate limiting (P0-055) ----------------------------------------------
# Redis token bucket on /auth/login and /auth/callback, per IP and per session.
# capacity is the burst size; the bucket fully refills over the window.
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# Comma-separated emails allowed to sign in (v1 is single-user)
AUTH_ALLOWED_EMAILS=

# --- YouTube connection (separate OAuth client, used from Phase 1A) ---------------
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Not read by the app directly (the connect route takes redirect_uri from the
# request body) - this documents the exact value to register as an
# "Authorized redirect URI" on the YouTube OAuth client in Google Cloud
# Console, and what callers should pass to POST /youtube/connect. The actual
# route is GET /youtube/connect/callback (connect.py), not /youtube/callback.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/youtube/connect/callback
# Stays false until verified and recorded (ADR 0007). Not a policy bypass.
YOUTUBE_DIRECT_UPLOAD_ENABLED=false
# 256-bit AES-GCM key, base64-encoded. Generate with:
# uv run python -c "from creatoriqx_api.platform.crypto import generate_key; print(generate_key())"
TOKEN_ENCRYPTION_KEY=

# --- AI (ADR 0005) -------------------------------------------------------------------
# mcp_bridge is the only enabled mode in v1
LLM_PROVIDER=mcp_bridge
# Mode B (Anthropic API) is disabled; enabling requires an owner ADR and a cap
ANTHROPIC_API_ENABLED=false
