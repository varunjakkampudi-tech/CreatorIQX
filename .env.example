# CreatorIQX environment template.
# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Every variable is read by the app at startup; missing required values fail fast.

# --- Runtime -----------------------------------------------------------------
# local | test | staging | production
APP_ENV=local
# Base URL the browser uses (web app and API share one origin in dev)
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- Database (PostgreSQL) -----------------------------------------------------
# Owner role: migrations only (owns tables)
DATABASE_OWNER_URL=postgresql+asyncpg://creatoriqx_owner:change-me-owner@localhost:5432/creatoriqx
# Runtime role: API, worker, MCP server (NOBYPASSRLS, owns no tables)
DATABASE_APP_URL=postgresql+asyncpg://creatoriqx_app:change-me-app@localhost:5432/creatoriqx
# Passwords used by the local Docker Postgres init script to create the roles
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Sessions ----------------------------------------------------------------
# Random secret, at least 64 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Google login (OIDC, login-only client, ADR 0004) ----------------------------
# Scopes are fixed in code to: openid email profile
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# Comma-separated emails allowed to sign in (v1 is single-user)
AUTH_ALLOWED_EMAILS=

# --- YouTube connection (separate OAuth client, used from Phase 1A) ---------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/youtube/callback
# Stays false until verified and recorded (ADR 0007). Not a policy bypass.
YOUTUBE_DIRECT_UPLOAD_ENABLED=false

# --- AI (ADR 0005) -------------------------------------------------------------------
# mcp_bridge is the only enabled mode in v1
LLM_PROVIDER=mcp_bridge
# Mode B (Anthropic API) is disabled; enabling requires an owner ADR and a cap
ANTHROPIC_API_ENABLED=false
